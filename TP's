def multiplier_matrices(m1, m2):
    """Calcule le produit matriciel de deux matrices."""
    n_l, p_k = len(m1), len(m1[0])
    if len(m2) != p_k:
        raise ValueError("dimensions incompatibles")
    q_c = len(m2[0])
    out = [[0] * q_c for _ in range(n_l)]
    for i in range(n_l):
        for j in range(q_c):
            val = 0
            for k in range(p_k):
                val += m1[i][k] * m2[k][j]
            out[i][j] = val
    return out


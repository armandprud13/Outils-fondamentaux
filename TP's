def resolution_gauss(mat_a, vect_b, tol=1e-14):
    dim = len(mat_a)
    aug = []
    for idx in range(dim):
        r = list(mat_a[idx])
        r.append(vect_b[idx])
        aug.append(r)

    for k in range(dim):
        idx_max = k
        for i in range(k + 1, dim):
            if abs(aug[i][k]) > abs(aug[idx_max][k]):
                idx_max = i
                
        if abs(aug[idx_max][k]) <= tol:
            print("Erreur : impossible à résoudre")
            return []
            
        aug[k], aug[idx_max] = aug[idx_max], aug[k]

        for i in range(k + 1, dim):
            coeff = aug[i][k] / aug[k][k]
            for j in range(k, dim + 1):
                aug[i][j] -= coeff * aug[k][j]

    sol = [0.0] * dim
    for i in range(dim - 1, -1, -1):
        cumul = aug[i][dim]
        for j in range(i + 1, dim):
            cumul -= aug[i][j] * sol[j]
        sol[i] = cumul / aug[i][i]
        
    return sol


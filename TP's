def calc_determinant(mat):
    dim = len(mat)
    grid = [list(row) for row in mat]
        
    val_det = 1.0
    for k in range(dim):
        piv = k
        for i in range(k + 1, dim):
            if abs(grid[i][k]) > abs(grid[piv][k]):
                piv = i
                
        if abs(grid[piv][k]) < 1e-14:
            return 0.0
            
        if piv != k:
            grid[k], grid[piv] = grid[piv], grid[k]
            val_det = -val_det
            
        val_det *= grid[k][k]
        
        for i in range(k + 1, dim):
            factor = grid[i][k] / grid[k][k]
            for j in range(k, dim):
                grid[i][j] -= factor * grid[k][j]
                
    return val_det


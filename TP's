def resolution_gauss(mat_a, vect_b, tol=1e-14):
    """Résolution d'un système linéaire Ax = b avec pivot de Gauss."""
    dim = len(mat_a)
    aug = [list(mat_a[i]) + [vect_b[i]] for i in range(dim)]

    for k in range(dim):
        piv = max(range(k, dim), key=lambda i: abs(aug[i][k]))
        if abs(aug[piv][k]) <= tol:
            raise ValueError("systeme singulier ou mal pose")
        aug[k], aug[piv] = aug[piv], aug[k]

        for i in range(k + 1, dim):
            coeff = aug[i][k] / aug[k][k]
            for j in range(k, dim + 1):
                aug[i][j] -= coeff * aug[k][j]

    sol = [0.0] * dim
    for i in range(dim - 1, -1, -1):
        cumul = aug[i][dim]
        for j in range(i + 1, dim):
            cumul -= aug[i][j] * sol[j]
        sol[i] = cumul / aug[i][i]
    return sol

